FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet_gas
    {
        type            fixedValue;
        value           uniform (10 0 0);
    }
	inlet_coolant
    {
        type            fixedValue;
        value           uniform (6.616228 4.6327327 0);// Ux=8.076923*cos35, Uy=8.076923*sin35
    }

    outlet
    {
        type            zeroGradient;
    }
	topwall
    {
        type            slip;
    }

    bottom_plate
    {
        type            noSlip;
    }
	hole_wall
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}


