FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet_gas
    {
       type            fixedValue;
       value           $internalField;
    }

    inlet_coolant
    {
        type            fixedValue;
        value           $internalField;
    }
	outlet
	{
	    type            fixedValue;
        value           $internalField;
	
	
	}

    topwall
    {
        type            zeroGradient;
        
    }
	bottom_plate
    {
        type            zeroGradient;
        
    }
	hole_wall
    {
        type            zeroGradient;
        
    }
	frontAndBack
	{
	type   empty;
	
	}
}


